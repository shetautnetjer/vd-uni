{
  "manifest_version": 3,
  "name": "VD-uni URL Capture",
  "version": "0.2.0",
  "description": "Capture video files and HLS/DASH manifests, with optional segment capture.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VD-uni URL Capture"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
