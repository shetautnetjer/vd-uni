{
  "manifest_version": 3,
  "name": "VD-uni URL Capture",
  "version": "0.1.0",
  "description": "Capture .ts/.m3u8 URLs for batch downloads with VD-uni.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VD-uni URL Capture"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": ["storage", "downloads", "webRequest"],
  "host_permissions": ["<all_urls>"]
}
